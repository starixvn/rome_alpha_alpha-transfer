@{
    ViewBag.Title = "Multiple Update Auto Transfer";
}

@using Alpha.Transfer.Site.ViewModels.AutoTransfer;
@model GetTransferConditionViewModel

@section Styles {
    @StaticResources.RenderStylesWithDarkMode("~/assets/bundles/auto-transfer/multiple-update")
}

<div id="result-msg" class="msg hide"></div>
<div class="div-usernames">@Model.Usernames.Replace(",", ", ")</div>
<div id="switch-auto-transfer" class="switch-auto-transfer"></div>
<ul>
    <li>- @string.Format(Resources.AutoTransfer_InfoAffectTime, Model.TransferCondition)</li>
    <li>- @Resources.AutoTransfer_InfoCannotTransfer</li>
</ul>

<input type="hidden" id="custIds" value="@Model.SearchAccountIds" />
@Html.Hidden("confirmTurnOnAutoTransfer", Resources.confirmTurnOnAutoTransfer)
@Html.Hidden("confirmTurnOffAutoTransfer", Resources.confirmTurnOffAutoTransfer)
@Html.Hidden("lblOn", Resources.On)
@Html.Hidden("lblOff", Resources.Off)
@section Scripts {
    @StaticResources.RenderScripts("~/assets/bundles/auto-transfer/multiple-update")
}
