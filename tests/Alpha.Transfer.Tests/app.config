<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>

    <section name="Fanex.Caching" type="Fanex.Caching.Configuration.CacheSettings, Fanex.Caching" />
    <section name="couchbase" type="Couchbase.Configuration.CouchbaseClientSection, Couchbase" />
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
  </configSections>
  <couchbase>
    <servers bucket="Alpha" bucketPassword="">
      <add uri="http://10.18.200.103:8091/pools/default" />
    </servers>
  </couchbase>
  <appSettings>
    <add key="MultipleTransferCacheTimeOut" value="600" />
    <add key="EnableTransferLogInfo" value="1" />
    <add key="LogLibs" value="Sentry,Rabbit" />
    <add key="Fanex.Logging:DefaultCategory" value="Alpha-MBC-AF-Local" />
    <add key="Fanex.Logging:RabbitMQConnectionStrings" value="host=10.18.200.103;virtualHost=/Fanex_Logging;username=fanexlogging;password=YKQrMtla7oYZGlP8apPtSw==" />
    <add key="Fanex.Logging:SentryUrl" value="https://fd52d23b3f4d41e3b44539f50c7bd8d6@sentry.nexdev.net/43" />
    <add key="Fanex.Logging:SentryBackendUrl" value="https://fd52d23b3f4d41e3b44539f50c7bd8d6@sentry.nexdev.net/43" />
  </appSettings>
  <Fanex.Logging msmqPath="FormatName:DIRECT=tcp:10.18.200.103\private$\entlib" defaultCategory="Alpha-MBC-AF-Local" />
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-10.0.0.0" newVersion="10.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>

  <Fanex.Caching cacheType="Fanex.Caching.Memory.MemoryCache, Fanex.Caching">
    <connectionSettings>
      <add name="CompactOnMemoryPressure" value="true" />
      <add name="ExpirationScanFrequency" value="1" />
    </connectionSettings>
  </Fanex.Caching>
</configuration>