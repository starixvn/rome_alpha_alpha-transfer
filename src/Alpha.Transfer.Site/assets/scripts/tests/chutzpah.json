{
  "Framework": "jasmine",
  "EnableCodeCoverage": "true",
  "Compile": {
    "Mode": "External",
    "Extensions": [ ".ts" ]
  },
  "CodeCoverageExcludes": [
    "*\\libs\\*"
  ],
  "CodeCoverageIgnores": [
    "*\\tests\\*"
  ],

  "CodeCoverageExecutionMode": "Manual",
  "References": [
    { "Path": "libs/jquery/jquery-1.11.3.js" },
    { "Path": "libs/jasmine.js" },
    { "Path": "libs/jasmine-jquery.js" },

    { "Path": "libs/jquery/blockUI.js" },
    { "Path": "libs/autocomplete.js" },
    { "Path": "../cash-balance-transfer/cash-balance.ts" },
    { "Path": "../transfer-all-clear-credit/calculation.ts" },
    { "Path": "../transfer-all-clear-credit/transfer-result.ts" }
  ],
  "Tests": [
    {
      "Path": "apps/cash-balance-transfer",
      "Excludes": [ "**.js.map", "**.js", "**-template.ts" ]
    },
    {
      "Path": "apps/transfer-all-clear-credit",
      "Excludes": [ "**.js.map", "**.js", "**-template.ts" ]
    }
  ]
}
