{
  "Framework": "jasmine",
  "EnableCodeCoverage": "true",
  "Compile": {
    "Mode": "External",
    "Extensions": [ ".ts" ]
  },
  "CodeCoverageExcludes": [
    "*\\libs\\*"
  ],
  "CodeCoverageIgnores": [
    "*\\tests\\*"
  ],

  "CodeCoverageExecutionMode": "Manual",
  "References": [
    { "Path": "libs/jquery/jquery-1.11.3.js" },
    { "Path": "libs/jasmine.js" },
    { "Path": "libs/jasmine-jquery.js" },

    { "Path": "libs/jquery/blockUI.js" },
    { "Path": "libs/moment.js" },
    { "Path": "libs/datepicker.js" },
    { "Path": "libs/bootstrap/datetimepicker.js" },
    { "Path": "libs/bootstrap/nexDatePicker.js" },
    { "Path": "libs/bootstrap/multiselect.js" },
    { "Path": "libs/autocomplete.js" },
    { "Path": "libs/data-table/jquery.dataTables.js" },
    { "Path": "libs/data-table/jdataTables.fixedHeader.js" },
    { "Path": "libs/data-table/dataTables.responsive.js" },
    { "Path": "libs/data-table/dataTables.pagination.input.js" },
    { "Path": "../cash-balance-transfer/cash-balance.ts" },
    { "Path": "../transfer-all-clear-credit/calculation.ts" },
    { "Path": "../transfer-all-clear-credit/transfer-result.ts" },
    { "Path": "../components/daterangepicker.ts" },
    { "Path": "../utils.ts" },
    { "Path": "../transfer-to-downline-history/transfer-report.ts" },
    { "Path": "../transfer-to-downline-history/index.ts" }
  ],
  "Tests": [
    {
      "Path": "apps/cash-balance-transfer",
      "Excludes": [ "**.js.map", "**.js", "**-template.ts" ]
    },
    {
      "Path": "apps/components",
      "Excludes": [ "**.js.map", "**.js", "**-template.ts" ]
    },
    {
      "Path": "apps/transfer-all-clear-credit",
      "Excludes": [ "**.js.map", "**.js", "**-template.ts" ]
    },
    {
      "Path": "apps/transfer-to-downline-history",
      "Excludes": [ "**.js.map", "**.js", "**-template.ts" ]
    }
  ]
}
