@{
    Layout = "~/Views/CashBalanceTransfer/_HintLayout.cshtml";
}
@if (Model.IsAlldayTransfer)
{
    <p>โอนยอดคงเหลือเมื่อวาน</p>
    <ul>
        <li>สามารถโอน"ยอดคงเหลือเมื่อวาน"เป็นจำนวนเต็มเท่านั้น</li>
        <li>จะสามารถทำการโอนเงินได้เมื่อยอดเงินคงเหลือเมือวานของสมาชิกไม่เป็นศูนย์</li>
    </ul>
    <p>โอนโดยยอดเงินสดคงเหลือ</p>
    <ul>
        <li>สำหรับโอนยอดเงินที่ติดลบ：ยอดเงินการโอนต้องไม่เกิน (ยอดคงเหลือเงินสด–รายการคงค้างของดาวไลน์)</li>
        <li>สำหรับการโอนเงินที่เป็นบวก：ยอดเงินการโอนต้องไม่เกินยอดคงเหลือเงินสดของคุณ</li>
        <li>"ยอดเงินสดคงเหลือ" ก็จะมีการระบุไว้ในรายละเอียดการโอน</li>
    </ul>
    <p>หมายเหตุ</p>
    <ul class="ul-remark">
        @if (!string.IsNullOrEmpty(Model.AllowTransfer))
        {
            <li>@Html.Raw(Model.AllowTransfer)</li>
        }
        @if (!string.IsNullOrEmpty(Model.WarningTransfer))
        {
            <li>@Html.Raw(Model.WarningTransfer)</li>
        }
        <li>คุณสามารถทำรายการได้มากเท่าที่ต้องการต่อวัน (ทั้งยอดคงเหลือเมื่อวานและยอดคงเหลือเงินสด)</li>
        <li>เพื่อให้มั่นใจถึงความถูกต้องของข้อมูลขณะประมวลผลธุรกรรมโอนเงินทั้งหมดไม่สามารถดำเนินการได้ในขณะนั้น</li>
        <li>@Resources.showhidecolumnAd</li>
    </ul>
}
else
{
    <p>หมายเหตุ</p>
    <ul class="ul-remark">
        @if (!string.IsNullOrEmpty(Model.AllowTransfer))
        {
            <li>@Html.Raw(Model.AllowTransfer)</li>
        }
        @if (!string.IsNullOrEmpty(Model.WarningTransfer))
        {
            <li>@Html.Raw(Model.WarningTransfer)</li>
        }
        <li>@Resources.showhidecolumnAd</li>
    </ul>
}

<ul>
    <li>The Auto Transfer process will be executed at <span class="blue-text">12:15 AM </span>(GMT+8)</li>
    <li>To ensure the accuracy of data while auto transfer us running, you CANNOT transfer to your downline whose auto transfer option is on at the process time.</li>
    <li>If you turn ON auto transfer setting during the process time, it will take effect at the next schedule defined by your account's Transfer Condition.</li>
</ul>