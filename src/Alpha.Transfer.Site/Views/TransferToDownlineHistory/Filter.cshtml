@model TransferToDownlineHistoryFilterViewModel

<form id="filter-form"
      class="form-inline filter"
      role="form"
      action="Index">
    <div class="form-group">
        <input type="text"
               id="txt-username"
               name="UserName"
               placeholder="@Resources.Username"
               value="@Model.UserName"
               class="@(string.IsNullOrWhiteSpace(Model.UserName) ? "text-italic" : "")" />
    </div>

    @DateRangePicker.Render(Model.DateRangePickerViewModel)

    <input type="hidden" id="txt-pagesize" name="PageSize" value="@Model.PageSize" />
    <input type="hidden" id="text-page" name="Page" value="@Model.Page" />
    <div class="form-group">
        <span id="icon-excel" class="icon-excel" title="@Resources.ExportToExcel"></span>
    </div>

    <div class="note">
        <span class="star">*</span>@Model.ViewDataInstructionMessage
    </div>
</form>