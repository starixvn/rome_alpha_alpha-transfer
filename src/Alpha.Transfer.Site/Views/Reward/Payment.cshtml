@model Alpha.Transfer.Site.ViewModels.Reward.RewardPaymentViewModel
@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewBag.Title = Resources.RewardPayment;
    var level = Model.ActorLevel.DisplayName.ToLowerInvariant();
}
@section Styles {

    @StaticResources.AssetStyles.Render("/bundles-v2/site-transfer/reward")
    @StaticResources.RenderStyles("~/assets/bundles-v2/reward/reward")
}
@section Scripts {
    @StaticResources.AssetScripts.Render("/bundles/site-transfer/filter")
    @StaticResources.RenderScripts("~/assets/bundles/reward/reward-payment")
}
<div class="page-title tabs @level">
    <ul class="nav nav-tabs" role="tablist">
        <li role="presentation" class="active">
            <a href="#rewardPayment" aria-controls="home" role="tab" data-toggle="tab">@Resources.RewardPayment</a>
        </li>
        <li role="presentation">
            @Html.ActionLink(Resources.RewardDetail, "Detail", "Reward")
        </li>
    </ul>
    <div class="list-icon">
        <ul><li><span class="ic-arrow-up-circle ripple" id="icon-filter" title="@Resources.HideFilter" data-toggle="tooltip" data-placement="bottom"></span></li></ul>
    </div>
</div>
<div class="tab-content">
    <div role="tabpanel" class="tab-pane active" id="rewardPayment">
        @{ Html.RenderPartial("Filter", Model.Filter); }
        <div class="msg msg-success" style="display:none"></div>
        <div class="downline-table reward-payment">
            <div></div>
            <div class="list-icon">
                <ul>
                    <li><button type="button" class="button-apply" id="btn-confirmPayment" disabled>@Resources.ConfirmPayment</button></li>
                </ul>
            </div>
        </div>
        <div id="tbl-transfer-container">@{ Html.RenderPartial("PaymentData", Model.ReportData); }</div>
    </div>
</div>
@Html.AntiForgeryToken()
<div class="bootbox modal fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" id="modal-confirmPayment">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="icon icon-close close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true"></span></button>
                <h4 class="modal-title">@Resources.ConfirmPayment</h4>
            </div>
            <div class="modal-body">
                <div id="modal-body-content"></div>
                <div id="modal-body-showMore">
                    <p class="text-red">......</p>
                    <a href="javascript:;" id="link-showMore">@Resources.ShowAllErrorPayments</a>
                </div>
            </div>
            <div class="modal-footer">
                <div class="block-btn">
                    <button type="button" class="button-cancel" data-dismiss="modal">@Resources.Close</button>
                </div>
            </div>
        </div>
    </div>
</div>
<input type="hidden" id="hiddenUpdateRewardPaymentStatusConfirm" value="@Resources.UpdateRewardPaymentStatusConfirm" />
<input type="hidden" id="hiddenUpdateRewardPaymentStatusSuccessfully" value="@Resources.UpdateRewardPaymentStatusSuccessfully" />
<input type="hidden" id="hiddenUpdateAllRewardPaymentStatusSuccessfully" value="@Resources.UpdateAllRewardPaymentStatusSuccessfully" />
<input type="hidden" id="hiddenUpdateManyRewardPaymentStatusSuccessfully" value="@Resources.UpdateManyRewardPaymentStatusSuccessfully" />
